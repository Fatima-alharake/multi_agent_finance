APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./storage/finance.db
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads

# LLM & LangGraph Settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# LangSmith Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=financial-analyzer

# Alert thresholds
ALERT_NET_MARGIN_MIN=0.05
ALERT_DEBT_TO_EQUITY_MAX=2.5
ALERT_CURRENT_RATIO_MIN=1.1
ALERT_NET_DEBT_TO_EBITDA_MAX=3.5
ALERT_FCF_CONVERSION_MIN=0.5
